{
  "name": "favicon-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc -p public/tsconfig.json",
    "check": "tsc --noEmit && tsc -p public/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:golden": "node scripts/golden-check.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^26.4.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true
  },
  "type": "module"
}
