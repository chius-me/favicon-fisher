// Production: set a strong secret with:
//   npx wrangler secret put FVF_SIGNING_SECRET
// Optional: FVF_ALLOW_PRIVATE=1 only for trusted private networks (never on public internet).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "favicon-worker",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	}
}
